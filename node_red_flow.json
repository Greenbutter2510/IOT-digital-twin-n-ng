  {
    "id": "cmd-auto",
    "type": "function",
    "z": "tab-digital-twin",
    "name": "Yêu cầu AUTO chung",
    "func": "if (flow.get('gatewayPending')) return null; flow.set('allManual',false); msg.payload={scope:'gateway',action:msg.payload===true?'AUTO_ON':'AUTO_OFF'}; return msg;",
    "outputs": 1,
