  {
    "id": "fn-snapshot",
    "type": "function",
    "z": "tab-digital-twin",
    "name": "Trạng thái đã xác minh",
    "func": "const p=msg.payload; if (!p || !p.lamps) return null;\nconst ids=['lamp-01','lamp-02','lamp-03']; const ls=ids.map(id=>p.lamps[id]);\nconst fresh=ls.every(l=>l && l.available && !l.stale); const allAuto=fresh && ls.every(l=>l.mode==='AUTO'); const allManual=fresh && ls.every(l=>l.mode==='MANUAL');\nflow.set('allManual',allManual && !p.gatewayPending && !['TIMEOUT','TELEMETRY_TIMEOUT','REJECTED','PUBLISH_FAILED','INTERRUPTED','REQUEST_REJECTED'].includes(p.gatewayStatus)); flow.set('gatewayPending',!!p.gatewayPending);\nconst out=new Array(17).fill(null);\nout[0]={payload:p.luxValid?Number(p.lux):null};\nout[1]={payload:`${p.autoOffLux} lux (đã báo cáo) | AUTO ${allAuto?'BẬT':allManual?'TẮT':'KHÔNG XÁC ĐỊNH'} | ${p.gatewayPending?'ĐANG CHỜ ACK':p.gatewayStatus||'IDLE'}${fresh?'':' | OFFLINE/STALE'}`};\nif (fresh && !p.gatewayPending && (allAuto || allManual)) out[2]={payload:allAuto};\nif (fresh && Number.isInteger(p.autoOffLux) && !p.gatewayPending) out[3]={payload:p.autoOffLux};\nls.forEach((l,i)=>{\n  const base=4+i*3;\n  out[base]={payload:l&&l.available?`${l.state} / ${l.mode}${l.stale?' / STALE':''}`:'OFFLINE / CHƯA CÓ DỮ LIỆU'};\n  out[base+1]={payload:l&&l.sensorValid&&!l.stale?Number(l.currentMa):null};\n  out[base+2]={payload:l&&l.sensorValid&&!l.stale?Number(l.voltageV):null};\n  if (allManual && flow.get('allManual')) out[13+i]={payload:l.state==='ON'};\n});\nout[16]={payload:p};\nreturn out;",
    "outputs": 17,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 80,
    "wires": [
      [
        "ui-lux"
      ],
      [
        "ui-system"
      ],
      [
        "switch-auto"
      ],
