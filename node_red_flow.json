  {
    "id": "cmd-threshold",
    "type": "function",
    "z": "tab-digital-twin",
    "name": "Yêu cầu ngưỡng",
    "func": "if (flow.get('gatewayPending')) return null; const threshold=Number(msg.payload); if (!Number.isInteger(threshold)||threshold<100||threshold>1000||threshold%10) return null; flow.set('allManual',false); msg.payload={scope:'gateway',action:'SET_THRESHOLD',threshold}; return msg;",
    "outputs": 1,
