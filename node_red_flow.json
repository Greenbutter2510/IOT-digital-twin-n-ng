    "id": "mqtt-verified",
    "type": "mqtt in",
    "z": "tab-digital-twin",
    "name": "Verified telemetry only",
    "topic": "city/digital-twin/verified/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "broker-private",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
