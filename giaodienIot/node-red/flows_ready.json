    "width": 12,
    "height": 14,
    "format": "<!-- Cảnh ba cột đèn đường: chỉ đọc snapshot telemetry đã xác minh. -->\r\n<style>\r\n  .dt-classroom-root {\r\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\r\n    background: #0f172a;\r\n    color: #f8fafc;\r\n    border-radius: 8px;\r\n    padding: 10px;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n  }\r\n  .dt-topbar {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 6px;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    margin-bottom: 8px;\r\n  }\r\n  .dt-top-pill {\r\n    font-size: 12px;\r\n    padding: 4px 8px;\r\n    border-radius: 4px;\r\n    font-weight: 600;\r\n    background: #1e293b;\r\n    border: 1px solid #334155;\r\n  }\r\n  .dt-pill-ok { border-color: #10b981; color: #a7f3d0; }\r\n  .dt-pill-warn { border-color: #f59e0b; color: #fde68a; background: #451a03; }\r\n  .dt-pill-auto { border-color: #38bdf8; color: #bae6fd; }\r\n  .dt-pill-manual { border-color: #a855f7; color: #e9d5ff; }\r\n  .dt-pill-mixed { border-color: #ef4444; color: #fecaca; background: #450a0a; }\r\n\r\n  .dt-gateway-banner {\r\n    font-size: 12px;\r\n    padding: 6px 10px;\r\n    border-radius: 5px;\r\n    margin-bottom: 8px;\r\n    font-weight: 600;\r\n  }\r\n  .dt-banner-ok { background: #064e3b; color: #d1fae5; border: 1px solid #059669; }\r\n  .dt-banner-pending { background: #78350f; color: #fef3c7; border: 1px solid #f59e0b; }\r\n  .dt-banner-err { background: #7f1d1d; color: #fee2e2; border: 1px solid #ef4444; }\r\n\r\n  .dt-viewport-wrap {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 320px;\r\n    background: #161b22;\r\n    border-radius: 6px;\r\n    border: 1px solid #334155;\r\n    overflow: hidden;\r\n    margin-bottom: 10px;\r\n  }\r\n  .dt-webgl-host { width: 100%; height: 100%; touch-action: none; }\r\n  .dt-loading-overlay {\r\n    position: absolute;\r\n    inset: 0;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    background: rgba(15, 23, 42, 0.85);\r\n    font-size: 13px;\r\n    font-weight: 600;\r\n  }\r\n  .dt-cam-toolbar {\r\n    position: absolute;\r\n    top: 8px;\r\n    right: 8px;\r\n    display: flex;\r\n    gap: 6px;\r\n    z-index: 5;\r\n  }\r\n  .dt-cam-btn {\r\n    background: rgba(15, 23, 42, 0.85);\r\n    color: #e2e8f0;\r\n    border: 1px solid #475569;\r\n    border-radius: 4px;\r\n    padding: 4px 8px;\r\n    font-size: 11px;\r\n    cursor: pointer;\r\n  }\r\n  .dt-cam-btn:hover { border-color: #38bdf8; }\r\n  .dt-viewport-hint {\r\n    position: absolute;\r\n    bottom: 6px;\r\n    left: 8px;\r\n    right: 8px;\r\n    font-size: 11px;\r\n    color: #94a3b8;\r\n    background: rgba(15, 23, 42, 0.78);\r\n    padding: 3px 7px;\r\n    border-radius: 4px;\r\n    pointer-events: none;\r\n  }\r\n\r\n  .dt-lamp-cards {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 8px;\r\n    margin-bottom: 10px;\r\n  }\r\n  .dt-lamp-card {\r\n    background: #1e293b;\r\n    color: #f8fafc;\r\n    border: 2px solid #334155;\r\n    border-radius: 6px;\r\n    padding: 8px;\r\n    text-align: left;\r\n    cursor: pointer;\r\n  }\r\n  .dt-card-selected { border-color: #38bdf8; background: #0f172a; }\r\n  .dt-card-degraded {\r\n    border-color: #f59e0b;\r\n    background-image: repeating-linear-gradient(\r\n      -45deg,\r\n      rgba(245, 158, 11, 0.08),\r\n      rgba(245, 158, 11, 0.08) 8px,\r\n      transparent 8px,\r\n      transparent 16px\r\n    );\r\n  }\r\n  .dt-card-head {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    font-size: 12px;\r\n    margin-bottom: 6px;\r\n  }\r\n  .dt-card-badges { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }\r\n  .dt-badge {\r\n    font-size: 11px;\r\n    padding: 2px 6px;\r\n    border-radius: 4px;\r\n    font-weight: 700;\r\n  }\r\n  .dt-b-on { background: #854d0e; color: #fef08a; }\r\n  .dt-b-off { background: #334155; color: #cbd5e1; }\r\n  .dt-b-mode { background: #1e3a8a; color: #bfdbfe; }\r\n  .dt-b-online { background: #065f46; color: #a7f3d0; }\r\n  .dt-b-stale { background: #92400e; color: #fde68a; }\r\n  .dt-b-offline { background: #7f1d1d; color: #fecaca; }\r\n  .dt-card-metrics {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 11px;\r\n    color: #cbd5e1;\r\n  }\r\n\r\n  .dt-detail-pane {\r\n    background: #1e293b;\r\n    border: 1px solid #334155;\r\n    border-radius: 6px;\r\n    padding: 10px;\r\n    font-size: 12px;\r\n  }\r\n  .dt-detail-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    padding-bottom: 6px;\r\n    margin-bottom: 8px;\r\n    border-bottom: 1px solid #334155;\r\n  }\r\n  .dt-stale-overlay-note {\r\n    background: #451a03;\r\n    border: 1px solid #f59e0b;\r\n    color: #fde68a;\r\n    padding: 6px 8px;\r\n    border-radius: 4px;\r\n    margin-bottom: 8px;\r\n  }\r\n  .dt-pending-overlay-note {\r\n    background: #1e3a8a;\r\n    border: 1px solid #38bdf8;\r\n    color: #bae6fd;\r\n    padding: 6px 8px;\r\n    border-radius: 4px;\r\n    margin-bottom: 8px;\r\n  }\r\n  .dt-detail-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 6px 12px;\r\n  }\r\n  .dt-detail-item {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    background: #0f172a;\r\n    padding: 5px 8px;\r\n    border-radius: 4px;\r\n  }\r\n\r\n  /* Tối ưu cho màn hình điện thoại ~400px */\r\n  @media (max-width: 540px) {\r\n    .dt-viewport-wrap { height: 250px; }\r\n    .dt-lamp-cards { grid-template-columns: 1fr; }\r\n    .dt-detail-grid { grid-template-columns: 1fr; }\r\n  }\r\n</style>\r\n\r\n<div id=\"dt-classroom-container\" class=\"dt-classroom-root\">\r\n  <!-- Thanh thông tin cảm biến Lux chung & Chế độ hệ thống -->\r\n  <div class=\"dt-topbar\">\r\n    <span class=\"dt-top-pill dt-lux-badge\">☀️ BH1750: Đang chờ dữ liệu...</span>\r\n    <span class=\"dt-top-pill dt-threshold-badge\">🎚️ Ngưỡng T: 150 lx (Bật &lt; 100 lx | Tắt &gt; 150 lx)</span>\r\n    <span class=\"dt-top-pill dt-mode-badge\">⏳ Chế độ: Đang đồng bộ...</span>\r\n  </div>\r\n\r\n  <!-- Banner trạng thái xác minh Gateway / ACK -->\r\n  <div class=\"dt-gateway-banner dt-banner-ok\">\r\n    🛡️ Đang chờ snapshot đã xác minh từ topic <code>city/digital-twin/verified/telemetry</code>...\r\n  </div>\r\n\r\n  <!-- Đoạn đường 3D hoặc sơ đồ 2D dự phòng -->\r\n  <div class=\"dt-viewport-wrap\">\r\n    <div class=\"dt-cam-toolbar\">\r\n      <button type=\"button\" class=\"dt-cam-btn dt-btn-reset-cam\">🎥 Đặt lại góc nhìn</button>\r\n      <button type=\"button\" class=\"dt-cam-btn dt-btn-toggle-2d\">📐 Chuyển sang 2D</button>\r\n    </div>\r\n    <div class=\"dt-webgl-host\"></div>\r\n    <div class=\"dt-fallback-2d\" style=\"display:none; padding:10px;\">\r\n      <div class=\"dt-2d-reason\" style=\"font-size:11px; color:#fde68a; margin-bottom:6px;\"></div>\r\n      <div class=\"dt-2d-svg-wrap\"></div>\r\n    </div>\r\n    <div class=\"dt-loading-overlay\">⏳ Đang dựng đoạn đường và ba cột đèn...</div>\r\n    <div class=\"dt-viewport-hint\">\r\n      Ba cột tương ứng L1–L3 · Ánh sáng biểu diễn ON/OFF, không phải mức PWM. Chọn cột để xem dữ liệu.\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Ba thẻ trạng thái cột đèn L1, L2, L3 -->\r\n  <div class=\"dt-lamp-cards\"></div>\r\n\r\n  <!-- Bảng thông số chi tiết của đèn đang chọn -->\r\n  <div class=\"dt-detail-pane\"></div>\r\n</div>\r\n\r\n<script>\r\n(function(scope) {\r\n  var twinInstance = null;\r\n  var destroyed = false;\r\n  var bootstrapTimer;\r\n\r\n  function showLoadError(message) {\r\n    var root = document.getElementById('dt-classroom-container');\r\n    var overlay = root && root.querySelector('.dt-loading-overlay');\r\n    if (overlay && !destroyed) overlay.textContent = '⚠️ ' + message + ' Kiểm tra httpStatic và tải lại trang.';\r\n  }\r\n\r\n  function loadLocalScriptOnce(src, callback) {\r\n    var selector = 'script[data-dt-script=\"' + src + '\"]';\r\n    var script = document.querySelector(selector);\r\n    if (script && script.getAttribute('data-loaded') === 'error') {\r\n      script.parentNode.removeChild(script);\r\n      script = null;\r\n    }\r\n    if (!script) {\r\n      script = document.createElement('script');\r\n      script.src = src;\r\n      script.async = true;\r\n      script.setAttribute('data-dt-script', src);\r\n      script.addEventListener('load', function() { script.setAttribute('data-loaded', 'true'); });\r\n      script.addEventListener('error', function() { script.setAttribute('data-loaded', 'error'); });\r\n      document.head.appendChild(script);\r\n    }\r\n    if (script.getAttribute('data-loaded') === 'true') { callback(null); return; }\r\n    var onLoad = function() { cleanup(); callback(null); };\r\n    var onError = function() { cleanup(); callback(src); };\r\n    function cleanup() {\r\n      script.removeEventListener('load', onLoad);\r\n      script.removeEventListener('error', onError);\r\n    }\r\n    script.addEventListener('load', onLoad);\r\n    script.addEventListener('error', onError);\r\n  }\r\n\r\n  function bootstrapScene() {\r\n    var rootEl = document.getElementById('dt-classroom-container');\r\n    if (!rootEl || twinInstance || destroyed) return;\r\n    loadLocalScriptOnce('/static/vendor/three.min.js', function(error) {\r\n      if (destroyed) return;\r\n      if (error) { showLoadError('Không tải được ' + error); return; }\r\n      loadLocalScriptOnce('/static/classroom_twin_3d.js', function(secondError) {\r\n        if (destroyed) return;\r\n        if (secondError || !window.ClassroomTwinApp) {\r\n          showLoadError('Không tải được mô hình đèn đường 3D.');\r\n          return;\r\n        }\r\n        twinInstance = new window.ClassroomTwinApp(rootEl);\r\n        if (scope.msg && scope.msg.payload && scope.msg.payload.lamps) {\r\n          twinInstance.applyVerifiedSnapshot(scope.msg.payload);\r\n        }\r\n      });\r\n    });\r\n  }\r\n\r\n  // Chỉ nhận nhánh snapshot đã xác minh của flow chính; widget này không phát lệnh.\r\n  var unwatch = scope.$watch('msg', function(newMsg) {\r\n    if (newMsg && newMsg.payload && newMsg.payload.lamps && twinInstance) {\r\n      twinInstance.applyVerifiedSnapshot(newMsg.payload);\r\n    }\r\n  });\r\n\r\n  scope.$on('$destroy', function() {\r\n    destroyed = true;\r\n    clearTimeout(bootstrapTimer);\r\n    if (unwatch) unwatch();\r\n    if (twinInstance) twinInstance.dispose();\r\n    twinInstance = null;\r\n  });\r\n\r\n  bootstrapTimer = setTimeout(bootstrapScene, 60);\r\n})(scope);\r\n</script>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
