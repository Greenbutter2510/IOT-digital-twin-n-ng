# MQTT noi bo/private. Khong dung public broker cho deployment.
IOT_MQTT_BROKER=127.0.0.1
IOT_MQTT_PORT=1883
IOT_MQTT_USERNAME=streetlight_backend
IOT_MQTT_PASSWORD=REPLACE_ME

# Phai trung voi include/secrets.h cua ESP32.
IOT_HMAC_LAMP_01=REPLACE_WITH_A_LONG_RANDOM_SECRET
IOT_HMAC_LAMP_02=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
IOT_HMAC_LAMP_03=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# ThingsBoard: mot device dai dien cho ca gateway ba den.
TB_ENABLED=false
TB_HOST=mqtt.thingsboard.cloud
TB_PORT=8883
TB_DEVICE_TOKEN=YOUR_DEVICE_ACCESS_TOKEN
# De trong de dung CA store cua he dieu hanh; hoac dat duong dan PEM tin cay.
TB_CA_CERT=
TB_QUEUE_SIZE=100
IOT_STALE_AFTER_MS=15000
IOT_MAX_CLOCK_SKEW_MS=120000
# Chi bat khi demo bang Wokwi (simulation co the chay cham hon dong ho that).
IOT_SIMULATION_CLOCK=false

# Nguong can hieu chuan theo tai that. De trong min/max de tat canh bao dien ap.
IOT_VOLTAGE_MIN=
IOT_VOLTAGE_MAX=
IOT_OFF_LEAK_MA=100
IOT_ON_MIN_MA=10
IOT_MAX_CURRENT_MA=1000
